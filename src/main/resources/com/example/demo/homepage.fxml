<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.example.demo.controller.homepage"
        prefWidth="1000"
        prefHeight="650"
        style="-fx-background-color: #101722;">

    <!-- COIN -->
    <HBox
            alignment="CENTER"
            spacing="8"
            AnchorPane.topAnchor="25"
            AnchorPane.rightAnchor="35"
            style="
                -fx-background-color: #17243a;
                -fx-background-radius: 20;
                -fx-border-color: #40536d;
                -fx-border-radius: 20;
                -fx-padding: 8 16 8 16;
            ">

        <Label
                text="●"
                style="
                    -fx-text-fill: #ffc107;
                    -fx-font-size: 22px;
                    -fx-font-weight: bold;
                "/>

        <Label
                fx:id="coinLabel"
                text="0"
                style="
                    -fx-text-fill: white;
                    -fx-font-size: 18px;
                    -fx-font-weight: bold;
                "/>

    </HBox>

    <!-- MAIN CONTENT -->
    <VBox
            alignment="CENTER"
            spacing="30"
            AnchorPane.topAnchor="90"
            AnchorPane.bottomAnchor="60"
            AnchorPane.leftAnchor="80"
            AnchorPane.rightAnchor="80">

        <Label
                text="GAME"
                style="
                    -fx-text-fill: white;
                    -fx-font-size: 35px;
                    -fx-font-weight: bold;
                "/>

        <GridPane
                alignment="CENTER"
                hgap="20"
                vgap="20">

            <Button
                    text="PLAY"
                    onAction="#openPlay"
                    prefWidth="240"
                    prefHeight="130"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"
                    style="-fx-background-color: #063d2b; -fx-border-color: #00e676; -fx-border-width: 3; -fx-border-radius: 18; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button
                    text="INVENTORY"
                    onAction="#openInventory"
                    prefWidth="240"
                    prefHeight="130"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"
                    style="-fx-background-color: #092b59; -fx-border-color: #168cff; -fx-border-width: 3; -fx-border-radius: 18; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-size: 21px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button
                    text="SHOP"
                    onAction="#openShop"
                    prefWidth="240"
                    prefHeight="130"
                    GridPane.columnIndex="2"
                    GridPane.rowIndex="0"
                    style="-fx-background-color: #503900; -fx-border-color: #ffc107; -fx-border-width: 3; -fx-border-radius: 18; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button
                    text="MY ACCOUNT"
                    onAction="#openMyAccount"
                    prefWidth="240"
                    prefHeight="130"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"
                    style="-fx-background-color: #32125d; -fx-border-color: #8e4cff; -fx-border-width: 3; -fx-border-radius: 18; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-size: 21px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button
                    text="SETTING"
                    onAction="#openSetting"
                    prefWidth="240"
                    prefHeight="130"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"
                    style="-fx-background-color: #263445; -fx-border-color: #73869d; -fx-border-width: 3; -fx-border-radius: 18; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button
                    text="FRIENDS"
                    onAction="#openFriends"
                    prefWidth="240"
                    prefHeight="130"
                    GridPane.columnIndex="2"
                    GridPane.rowIndex="1"
                    style="-fx-background-color: #541919; -fx-border-color: #ff4545; -fx-border-width: 3; -fx-border-radius: 18; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-cursor: hand;"/>

        </GridPane>
    </VBox>
</AnchorPane>
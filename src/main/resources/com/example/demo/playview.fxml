<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #0d1117;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.PlayController">
    <children>
        <!-- Back Button to Home -->
        <Button layoutX="30.0" layoutY="30.0" mnemonicParsing="false" onAction="#handleBackButton" style="-fx-background-color: #21262d; -fx-text-fill: #c9d1d9; -fx-border-color: #30363d; -fx-border-radius: 6px; -fx-cursor: hand;" text="&lt; Back to Home" />

        <!-- Main Center Box -->
        <VBox alignment="CENTER" layoutX="300.0" layoutY="180.0" spacing="25.0" style="-fx-background-color: #161b22; -fx-border-color: #30363d; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 40px;" AnchorPane.bottomAnchor="180.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0" AnchorPane.topAnchor="180.0">
            <children>
                <Label text="SELECT GAME MODE" textFill="#f0f6fc">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <!-- Create Room Button -->
                <Button mnemonicParsing="false" onAction="#handleCreateRoom" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #238636; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;" text="CREATE ROOM" />

                <!-- Join Room Button -->
                <Button mnemonicParsing="false" onAction="#handleJoinRoom" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #1f6feb; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;" text="JOIN ROOM" />
            </children>
        </VBox>
    </children>
</AnchorPane>